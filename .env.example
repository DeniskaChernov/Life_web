# --- Railway (PostgreSQL) ---
# В проекте Railway: добавьте сервис Postgres, затем в Web-сервисе задайте переменную DATABASE_URL
# (через «Variable Reference» на ${{Postgres.DATABASE_URL}} или скопируйте строку подключения из вкладки Postgres).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Секрет сессии NextAuth (openssl rand -base64 32)
NEXTAUTH_SECRET=""

# Публичный URL вашего Web-сервиса на Railway (Settings → Networking → Public URL)
NEXTAUTH_URL="https://your-service.up.railway.app"

# Локально для prisma migrate / studio можно временно подставить postgres://… или Docker (см. docker-compose.yml).

# --- Google OAuth (опционально; при наличии на /login появится «Войти через Google») ---
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web).
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
