generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────────────
// Users
// ────────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  name         String?
  avatarUrl    String?
  timezone     String   @default("UTC")
  currency     String   @default("RUB")
  onboardingCompleted Boolean @default(false)
  settings     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  graphs              Graph[]
  nodes               Node[]
  edges               Edge[]
  nodeSnapshots       NodeSnapshot[]
  aiInteractions      AiInteraction[]
  passwordResetTokens PasswordResetToken[]
  netWorthSnapshots   NetWorthSnapshot[]
  cashflowEntries     CashflowEntry[]
  properties          Property[]
  scenarios           Scenario[]
}

// ────────────────────────────────────────────────────────────────────────────────
// Password reset
// ────────────────────────────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ────────────────────────────────────────────────────────────────────────────────
// Graphs (root + sub-graphs that hang off a node, for "drill-in" navigation)
// ────────────────────────────────────────────────────────────────────────────────

model Graph {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isRoot      Boolean  @default(true)
  parentNodeId String?
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  nodes Node[]
  edges Edge[]

  @@index([userId])
  @@index([parentNodeId])
}

// ────────────────────────────────────────────────────────────────────────────────
// Nodes (LIFE_MASTER_BLUEPRINT.md, section 11 — extended)
// ────────────────────────────────────────────────────────────────────────────────

model Node {
  id            String    @id @default(uuid())
  graphId       String
  graph         Graph     @relation(fields: [graphId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  path          String
  parentId      String?
  parent        Node?     @relation("NodeChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children      Node[]    @relation("NodeChildren")
  subgraphId    String?
  depth         Int       @default(0)

  title         String
  description   String?
  category      String
  subCategory   String?
  tags          String[]  @default([])

  status        String    @default("FUTURE")
  priority      String    @default("MEDIUM")
  progress      Int       @default(0)
  timeHorizon   String    @default("MONTH")
  energy        String    @default("STEADY")

  startDate     DateTime?
  targetDate    DateTime?
  completedAt   DateTime?

  positionX     Float     @default(0)
  positionY     Float     @default(0)
  color         String?
  icon          String?
  size          String    @default("MD")
  isPinned      Boolean   @default(false)
  isCollapsed   Boolean   @default(false)

  financialData Json?

  aiScore       Float?
  aiInsights    Json?

  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  outgoingEdges  Edge[]         @relation("EdgeSource")
  incomingEdges  Edge[]         @relation("EdgeTarget")
  snapshots      NodeSnapshot[]
  cashflowEntries CashflowEntry[]
  property       Property?

  @@index([graphId])
  @@index([userId])
  @@index([parentId])
  @@index([category])
  @@index([status])
  @@index([timeHorizon])
}

// ────────────────────────────────────────────────────────────────────────────────
// Edges (LIFE_MASTER_BLUEPRINT.md, section 4.2)
// ────────────────────────────────────────────────────────────────────────────────

model Edge {
  id          String   @id @default(uuid())
  graphId     String
  graph       Graph    @relation(fields: [graphId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId    String
  targetId    String
  source      Node     @relation("EdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target      Node     @relation("EdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)
  type        String   @default("RELATED")
  label       String?
  description String?
  strength    Float    @default(0.5)
  direction   String   @default("FORWARD")
  isAnimated  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sourceId, targetId, type])
  @@index([graphId])
  @@index([type])
}

// ────────────────────────────────────────────────────────────────────────────────
// Node snapshots — versioned history
// ────────────────────────────────────────────────────────────────────────────────

model NodeSnapshot {
  id        String   @id @default(uuid())
  nodeId    String
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version   Int
  snapshot  Json
  reason    String?
  createdAt DateTime @default(now())

  @@index([nodeId])
  @@index([userId])
  @@unique([nodeId, version])
}

// ────────────────────────────────────────────────────────────────────────────────
// AI interactions log
// ────────────────────────────────────────────────────────────────────────────────

model AiInteraction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  contextNodeId String?
  prompt    String?
  response  Json?
  accepted  Boolean?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([contextNodeId])
}

// ────────────────────────────────────────────────────────────────────────────────
// Financial system (LIFE_MASTER_BLUEPRINT.md §8, §11)
// ────────────────────────────────────────────────────────────────────────────────

model NetWorthSnapshot {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  assets           Json
  liabilities      Json
  totalAssets      Float
  totalLiabilities Float
  netWorth         Float
  notes            String?
  createdAt        DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

model CashflowEntry {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedNodeId    String?
  linkedNode      Node?     @relation(fields: [linkedNodeId], references: [id], onDelete: SetNull)
  date            DateTime  @db.Date
  type            String
  amount          Float
  currency        String    @default("RUB")
  category        String
  subcategory     String?
  description     String?
  isRecurring     Boolean   @default(false)
  recurringConfig Json?
  isActual        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([userId, date(sort: Desc)])
  @@index([category])
}

model Property {
  id                    String    @id @default(uuid())
  nodeId                String    @unique
  node                  Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                  String
  address               Json
  areaSqm               Float?
  floor                 Int?
  totalFloors           Int?
  yearBuilt             Int?
  purchasePrice         Float?
  purchaseDate          DateTime? @db.Date
  currentEstimatedValue Float?
  lastValuationDate     DateTime? @db.Date
  mortgageData          Json?
  rentalData            Json?
  monthlyExpenses       Json?
  improvements          Json      @default("[]")
  districtAnalysis      Json?
  lifecycleStatus       String    @default("PLANNING")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Scenario {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  type        String   @default("CUSTOM")
  parameters  Json
  results     Json?
  isActive    Boolean  @default(false)
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}
